# Database Connection (PostgreSQL asyncpg)
DATABASE_URL=postgresql+asyncpg://ledger_user:ledger_pass@localhost:5432/wallet_db

# Provider Integration
PROVIDER_BASE_URL=http://localhost:8001
PROVIDER_API_KEY=mock-provider-key-123
PROVIDER_WEBHOOK_SECRET=mock-webhook-secret-456
PROVIDER_TIMEOUT_SECONDS=5.0

# Webhook Security
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WALLET_CALLBACK_URL=http://localhost:8000/v1/webhooks/provider

# Server Settings
WALLET_HOST=0.0.0.0
WALLET_PORT=8000
