# ==============================================================================
# LedgerLite System Configuration (.env.example)
# Copy this file to .env and adjust variables if needed.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=ledger_user
POSTGRES_PASSWORD=ledger_pass
POSTGRES_DB=wallet_db
POSTGRES_PORT=5432

# Wallet Service Configuration
WALLET_PORT=8000
WALLET_HOST=0.0.0.0
WALLET_CALLBACK_URL=http://wallet-service:8000/v1/webhooks/provider
DATABASE_URL=postgresql+asyncpg://ledger_user:ledger_pass@localhost:5432/wallet_db

# Payment Provider Mock Configuration
PROVIDER_PORT=8001
PROVIDER_BASE_URL=http://localhost:8001
PROVIDER_BASE_PAY_URL=https://mock-provider.local/pay
PROVIDER_API_KEY=mock-provider-key-123
PROVIDER_WEBHOOK_SECRET=mock-webhook-secret-456
PROVIDER_TIMEOUT_SECONDS=5.0
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
